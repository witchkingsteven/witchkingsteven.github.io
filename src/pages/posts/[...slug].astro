---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { POST_TYPES } from '../../consts';
import { getPosts, postUrl, readingMinutes, tagSlug, typeUrl, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		// posts are newest first: "newer" is i-1, "older" is i+1
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, type, tags, draft } = post.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = type === 'writeup' && toc.length >= 3;
---

<Base title={title} description={description} ogType="article">
	<article class="container post">
		<header class="post-head">
			<div class="meta">
				<a class="badge" data-type={type} href={typeUrl(type)}>{POST_TYPES[type].label}</a>
				{draft && <span class="badge draft">Draft (local only)</span>}
				<span class="date">
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<>
								{' '}
								· updated <FormattedDate date={updatedDate} />
							</>
						)
					}
					{' · '}{readingMinutes(post)} min read
				</span>
			</div>
			<h1>{title}</h1>
			<p class="desc">{description}</p>
			{
				tags.length > 0 && (
					<div class="tags">
						{tags.map((t) => (
							<a class="tag" href={`/tags/${tagSlug(t)}/`}>
								#{t}
							</a>
						))}
					</div>
				)
			}
		</header>

		{
			showToc && (
				<nav class="toc" aria-label="On this page">
					<p class="eyebrow">On this page</p>
					<ol>
						{toc.map((h) => (
							<li class={`d${h.depth}`}>
								<a href={`#${h.slug}`}>{h.text}</a>
							</li>
						))}
					</ol>
				</nav>
			)
		}

		<div class="prose">
			<Content />
		</div>

		<nav class="pager" aria-label="More posts">
			{
				older ? (
					<a href={postUrl(older)}>
						<span class="eyebrow">← Older</span>
						{older.data.title}
					</a>
				) : (
					<span />
				)
			}
			{
				newer && (
					<a class="right" href={postUrl(newer)}>
						<span class="eyebrow">Newer →</span>
						{newer.data.title}
					</a>
				)
			}
		</nav>
	</article>
</Base>

<style>
	.post {
		max-width: calc(var(--measure) + 64px);
		padding-top: 3rem;
	}
	.post-head {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--line);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 14px;
		margin-bottom: 14px;
	}
	.meta a.badge {
		text-decoration: none;
	}
	.date {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--muted);
	}
	h1 {
		margin: 0 0 0.5rem;
	}
	.desc {
		font-size: 1.15rem;
		color: var(--ink-2);
		margin: 0 0 1rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.toc {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 14px 18px;
		margin-bottom: 2.5rem;
		max-width: var(--measure);
	}
	.toc ol {
		list-style: none;
		margin: 8px 0 0;
		padding: 0;
		font-size: 0.95rem;
	}
	.toc li {
		margin: 4px 0;
	}
	.toc .d3 {
		padding-left: 1.1rem;
	}
	.toc a {
		text-decoration: none;
	}
	.pager {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
		max-width: var(--measure);
	}
	.pager a {
		display: flex;
		flex-direction: column;
		gap: 2px;
		text-decoration: none;
		max-width: 48%;
	}
	.pager .right {
		text-align: right;
		margin-left: auto;
	}
</style>
