---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
---

<Base title="About" description={`${profile.headline} with ${profile.yearsExperience} years in cybersecurity.`}>
	<div class="container layout">
		<div class="main">
			<p class="eyebrow">About</p>
			<h1>{profile.name}</h1>
			<p class="headline">{profile.headline} · {profile.location}</p>
			<div class="prose">
				{profile.summary.map((p) => <p>{p}</p>)}
			</div>

			<h2 id="experience">Experience</h2>
			<ol class="timeline">
				{
					profile.experience.map((job) => (
						<li>
							<h3>{job.company}</h3>
							<ul class="roles">
								{job.roles.map((r) => (
									<li>
										<span class="role">{r.title}</span>
										<span class="when">
											{r.dates}
											{'location' in r && r.location ? ` · ${r.location}` : ''}
										</span>
									</li>
								))}
							</ul>
						</li>
					))
				}
			</ol>

			<h2 id="education">Education</h2>
			{
				profile.education.map((e) => (
					<div class="edu">
						<h3>{e.school}</h3>
						<span class="when">
							{e.degree} · {e.dates}
						</span>
					</div>
				))
			}
		</div>

		<aside class="side" aria-label="Skills and credentials">
			<section>
				<h2>Award</h2>
				<p class="award">🏆 {profile.award}</p>
			</section>
			<section>
				<h2>Certifications</h2>
				<ul>{profile.certifications.map((c) => <li>{c}</li>)}</ul>
			</section>
			<section>
				<h2>Top skills</h2>
				<div class="chips">{profile.skills.map((s) => <span class="tag">{s}</span>)}</div>
			</section>
			<section>
				<h2>Languages</h2>
				<p>{profile.languages.join(' · ')}</p>
			</section>
			<section>
				<h2>Elsewhere</h2>
				<ul>
					{
						profile.links.map((l) => (
							<li>
								<a href={l.href} rel="me noopener" target="_blank">
									{l.label} ↗
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</aside>
	</div>
</Base>

<style>
	.layout {
		display: grid;
		gap: 3rem;
		padding-top: 3rem;
	}
	@media (min-width: 900px) {
		.layout {
			grid-template-columns: minmax(0, 1fr) 280px;
		}
		.side {
			position: sticky;
			top: 84px;
			align-self: start;
		}
	}
	.headline {
		color: var(--muted);
		margin: 0 0 2rem;
	}
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0 0 0 20px;
		border-left: 2px solid var(--line);
	}
	.timeline > li {
		position: relative;
		padding-bottom: 1.6rem;
	}
	.timeline > li::before {
		content: '';
		position: absolute;
		left: -27px;
		top: 0.45em;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--accent);
	}
	.timeline h3,
	.edu h3 {
		margin: 0 0 6px;
		font-size: 1.1rem;
	}
	.roles {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 8px;
	}
	.role {
		display: block;
		font-weight: 500;
	}
	.when {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--muted);
	}
	.side section {
		border-top: 1px solid var(--line);
		padding: 14px 0 18px;
	}
	.side h2 {
		font-size: 0.8rem;
		font-family: var(--font-mono);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
		font-weight: 500;
		margin: 0 0 10px;
	}
	.side ul {
		margin: 0;
		padding-left: 1.1em;
		font-size: 0.95rem;
	}
	.side li + li {
		margin-top: 4px;
	}
	.side p {
		margin: 0;
		font-size: 0.95rem;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
</style>
