---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
	<div class="container wrap">
		<p class="eyebrow">404</p>
		<h1>Nothing at this path.</h1>
		<p>The page may have moved. Try <a href="/writing/">the writing index</a> or <a href="/">the home page</a>.</p>
	</div>
</Base>

<style>
	.wrap {
		padding-top: 5rem;
		max-width: 40rem;
	}
</style>
