---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { profile } from '../data/profile';
import { getPosts } from '../lib/posts';

const latest = (await getPosts()).slice(0, 5);
const current = profile.experience[0];
---

<Base>
	<section class="hero container">
		<p class="eyebrow">{profile.location}</p>
		<h1>{profile.shortName}</h1>
		<p class="headline">{profile.headline} <span>· {current.company}</span></p>
		<p class="lede">{profile.summary[0]}</p>
		<div class="actions">
			<a class="button primary" href="/writing/">Read the writing</a>
			<a class="button" href="/about/">Experience</a>
		</div>
	</section>

	<section class="container focus" aria-label="Focus areas">
		{
			profile.focus.map((f) => (
				<div class="focus-item">
					<h2>{f.title}</h2>
					<p>{f.text}</p>
				</div>
			))
		}
	</section>

	<section class="container latest">
		<div class="section-head">
			<h2>Latest writing</h2>
			<a href="/writing/">All entries →</a>
		</div>
		<PostList posts={latest} emptyText="First entries coming soon." />
	</section>

	<section class="container stats" aria-label="Highlights">
		<div><strong>{profile.yearsExperience}</strong><span>years in security</span></div>
		<div><strong>{profile.experience.length}</strong><span>organizations</span></div>
		<div><strong>BOTS</strong><span>Splunk Boss of the SOC CTF winner</span></div>
	</section>
</Base>

<style>
	.hero {
		padding-top: clamp(3rem, 9vw, 6.5rem);
		padding-bottom: 2.5rem;
	}
	.hero h1 {
		margin: 0.3rem 0 0.4rem;
		font-size: clamp(2.4rem, 7vw, 4rem);
	}
	.headline {
		font-size: 1.2rem;
		color: var(--ink);
		margin: 0 0 1.4rem;
		font-weight: 500;
	}
	.headline span {
		color: var(--muted);
		font-weight: 400;
	}
	.lede {
		max-width: 40rem;
		color: var(--ink-2);
		font-size: 1.12rem;
		margin: 0 0 2rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.button {
		display: inline-block;
		padding: 10px 18px;
		border-radius: 8px;
		border: 1px solid var(--line);
		color: var(--ink);
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
	}
	.button:hover {
		background: var(--surface-2);
		color: var(--ink);
	}
	.button.primary {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--bg);
	}
	.button.primary:hover {
		opacity: 0.88;
		background: var(--ink);
		color: var(--bg);
	}
	.focus {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 16px;
		margin-top: 1.5rem;
	}
	.focus-item {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 18px 20px;
		box-shadow: var(--shadow);
	}
	.focus-item h2 {
		font-size: 1rem;
		margin: 0 0 6px;
	}
	.focus-item h2::before {
		content: '> ';
		font-family: var(--font-mono);
		color: var(--accent);
	}
	.focus-item p {
		margin: 0;
		color: var(--ink-2);
		font-size: 0.95rem;
	}
	.latest {
		margin-top: 4rem;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		border-bottom: 1px solid var(--line);
		padding-bottom: 10px;
		margin-bottom: 10px;
	}
	.section-head h2 {
		margin: 0;
		font-size: 1.25rem;
	}
	.section-head a {
		font-size: 0.92rem;
		text-decoration: none;
		white-space: nowrap;
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 16px;
		margin-top: 4rem;
	}
	.stats div {
		border-top: 2px solid var(--accent);
		padding-top: 12px;
	}
	.stats strong {
		display: block;
		font-family: var(--font-mono);
		font-size: 1.8rem;
		line-height: 1.2;
	}
	.stats span {
		color: var(--muted);
		font-size: 0.92rem;
	}
</style>
