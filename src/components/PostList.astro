---
import FormattedDate from './FormattedDate.astro';
import { POST_TYPES } from '../consts';
import { postUrl, readingMinutes, type Post } from '../lib/posts';

interface Props {
	posts: Post[];
	showType?: boolean;
	emptyText?: string;
}

const { posts, showType = true, emptyText = 'Nothing here yet.' } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="empty">{emptyText}</p>
	) : (
		<ul class="posts">
			{posts.map((post) => (
				<li>
					<a class="card" href={postUrl(post)}>
						<div class="meta">
							{showType && (
								<span class="badge" data-type={post.data.type}>
									{POST_TYPES[post.data.type].label}
								</span>
							)}
							{post.data.draft && <span class="badge draft">Draft</span>}
							<span class="date">
								<FormattedDate date={post.data.pubDate} /> · {readingMinutes(post)} min
							</span>
						</div>
						<h2 class="title">{post.data.title}</h2>
						<p>{post.data.description}</p>
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 4px;
	}
	.card {
		display: block;
		padding: 18px 16px;
		margin: 0 -16px;
		border-radius: var(--radius);
		color: inherit;
		text-decoration: none;
	}
	.card:hover {
		background: var(--surface-2);
	}
	.card:hover .title {
		color: var(--accent-ink);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 14px;
	}
	.date {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--muted);
	}
	.title {
		margin: 6px 0 4px;
		font-size: 1.15rem;
	}
	p {
		margin: 0;
		color: var(--ink-2);
		font-size: 0.98rem;
	}
	.empty {
		color: var(--muted);
	}
</style>
